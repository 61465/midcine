# midcine web — local dev secrets
# Copy to .env.local (git-ignored) and fill in your values.

# ─── Sketchfab Anatomy (free, no key needed) ─────────────────────────────
# Optional — pre-populate the anatomy tab with your favorite Sketchfab models.
# JSON array of { uuid, label }. Find UUIDs at sketchfab.com/search?q=anatomy
# Example:
# NEXT_PUBLIC_SKETCHFAB_UUIDS=[{"uuid":"abc123def456","label":"قلب-STEMI"},{"uuid":"789xyz","label":"دماغ"}]
NEXT_PUBLIC_SKETCHFAB_UUIDS=

# ─── mcp-bridge override ─────────────────────────────────────────────────
# If bridge runs on a non-default host/port
# MCP_BRIDGE_URL=http://localhost:8210
