# === midcine prototype — dev only ===
# انسخ هذا الملف إلى .env قبل تشغيل docker compose

# Tenancy
MIDCINE_DEV_TENANT_ID=11111111-1111-1111-1111-111111111111
MIDCINE_DEV_TENANT_SLUG=demo
MIDCINE_DEV_TENANT_PLAN=center
MIDCINE_DEV_USER_ID=22222222-2222-2222-2222-222222222222
MIDCINE_DEV_USER_EMAIL=demo@midcine.io
MIDCINE_DEV_USER_PASSWORD=DemoMidcine!2026

# PostgreSQL (ParadeDB image includes pgvector + pg_search)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=midcine
POSTGRES_USER=midcine_app
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme_dev_super
POSTGRES_URL=postgresql+asyncpg://midcine_app:changeme_dev_only@postgres:5432/midcine

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:13900
MINIO_ACCESS_KEY=midcine-dev
MINIO_SECRET_KEY=midcine-dev-secret-change-me
MINIO_BUCKET=midcine-studies
MINIO_USE_SSL=false

# Orthanc
ORTHANC_URL=http://orthanc:8042
ORTHANC_USERNAME=midcine
ORTHANC_PASSWORD=changeme_dev_only

# Auth (JWT)
JWT_SECRET=dev-only-32byte-secret-replace-me-please-1234567890
JWT_ALG=HS256
JWT_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# Field-level encryption (32 bytes base64) — dev only
FIELD_ENCRYPTION_KEY_B64=ZGV2X29ubHlfMzJfYnl0ZV9rZXlfZm9yX21pZGNpbmU=
FIELD_HMAC_KEY_B64=ZGV2X29ubHlfMzJfYnl0ZV9obWFjX2tleV9mb3JfbWlk

# LLM Backend
LLM_BACKEND=stub
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

# Vision AI (Ollama-based) — multimodal محلي مجاني
VISION_MODEL=moondream
VISION_AI_URL=http://vision-ai:8600
ENABLE_VISION_AI=true

# AI Worker
AI_TRIAGE_THRESHOLD=0.005

# Web
NEXT_PUBLIC_API_BASE=http://localhost:13100
NEXT_PUBLIC_VIEWER_URL=http://localhost:13030
NEXT_PUBLIC_WS_URL=ws://localhost:13100/v1/realtime

# FHIR
FHIR_CLIENT_ID=demo-his
FHIR_CLIENT_SECRET=dev-fhir-secret

# WhatsApp
WA_SIMULATE=true                       # false = اتصال Baileys حقيقي (يحتاج مسح QR)

# Observability
LOG_LEVEL=info
